<launch>
    <arg name="image_topic_name" default="/girona500/bravo/gripper/camera/image_rect/compressed" />

    <arg name="info_topic_name" default="/girona500/bravo/gripper/camera/camera_info" />
    
    <arg name="yaml_path" default="$(find net_hole_detector)/config/right_laser.yaml" />


    <node pkg="net_hole_detector" type="detector_node.py" name="net_hole_detector" output="screen">
        
        <param name="image_topic" value="$(arg image_topic_name)" />
        
        <param name="camera_info_topic" value="$(arg info_topic_name)" />

        <param name="calibration_file" value="$(arg yaml_path)" />
        
        </node>
</launch>