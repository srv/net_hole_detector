<launch>
    <arg name="sim" default="false"/>
    <param name="/use_sim_time" value="$(arg sim)"/>

    <arg name="final_image_topic" value="/hole_detector/image_processed"/>
    <arg name="camera_info_topic" default="/girona500/bravo/gripper/camera/camera_info"/>
    <arg name="yolo_output_topic" default="/net_hole_detector/detections"/>

    <include file="$(find net_hole_detector)/launch/yolo_inference.launch">
        <arg name="input_image_topic" value="$(arg final_image_topic)"/>
        <arg name="output_topic"      value="$(arg yolo_output_topic)"/>
    </include>

    <include file="$(find net_hole_detector)/launch/detector_3d.launch">
        <arg name="image_topic"       value="$(arg final_image_topic)"/>
        <arg name="camera_info_topic" value="$(arg camera_info_topic)"/>
        <arg name="yolo_input_topic"  value="$(arg yolo_output_topic)"/>
    </include>

</launch>