<launch>
    <arg name="image_topic"       default="" />
    <arg name="camera_info_topic" default="" />
    <arg name="yolo_input_topic"  default="" />
    <arg name="camera_frame"      default="girona500/bravo/gripper/camera" />
    <arg name="calibration_yaml"  default="$(find net_hole_detector)/config/right_laser.yaml" />

    <node pkg="net_hole_detector" type="detector_node.py" name="net_hole_detector_3d" output="screen">
        
        <param name="image_topic"        value="$(arg image_topic)" />
        <param name="camera_info_topic"  value="$(arg camera_info_topic)" />
        <param name="yolo_topic"         value="$(arg yolo_input_topic)" />
        <param name="camera_frame"       value="$(arg camera_frame)" />
        <param name="calibration_file"   value="$(arg calibration_yaml)" />
        
        <param name="max_detections"     value="5" />

        </node>
</launch>